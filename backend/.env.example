# Database — PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/contract_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# API server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:3000

# LLM Provider: watsonx | gemini | ollama | groq
LLM_PROVIDER=watsonx

# IBM watsonx.ai
WATSONX_API_KEY=your_value_here
WATSONX_PROJECT_ID=your_value_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
WATSONX_EMBED_MODEL=ibm/slate-125m-english-rtrvr-v2

# Google Gemini (optional)
GEMINI_API_KEY=your_value_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Groq (optional)
GROQ_API_KEY=your_value_here
GROQ_MODEL=llama-3.3-70b-versatile

# Neo4j — knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_value_here

# DataStax AstraDB — vector store
ASTRA_TOKEN=your_value_here
ASTRA_ENDPOINT=your_value_here

# Milvus (optional alternative to AstraDB)
MILVUS_HOST=your_value_here
MILVUS_PORT=30429
MILVUS_USER=your_value_here
MILVUS_PASSWORD=your_value_here

# Pipeline feature flags
ENABLE_DOCUMENT_INGESTION=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_AGENT_GENERATION=true
ENABLE_MULTI_AGENT_REVIEW=true
ENABLE_REPORT_GENERATION=true
OUTPUT_DIR=./output
LOG_LEVEL=INFO
